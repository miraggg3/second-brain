{
  "name": "second-brain",
  "private": true,
  "type": "module",
  "description": "Second Brain: Telegram Mini App (notes + life trackers) and its bot server",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "start": "node --env-file-if-exists=server/.env server/server.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@preact/signals": "2.11.4",
    "jszip": "3.10.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
