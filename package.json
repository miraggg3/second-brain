{
  "name": "second-brain",
  "private": true,
  "type": "module",
  "description": "Second Brain: Telegram Mini App (notes + life trackers) and its bot server",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && npm --prefix worker run typecheck",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@preact/signals": "2.11.4",
    "jszip": "3.10.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@preact/preset-vite": "2.10.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
