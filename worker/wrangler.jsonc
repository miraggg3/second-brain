{
  // Cloudflare Worker: Telegram bot (webhook) + API for the Mini App.
  // Setup steps are in ../README.md, section "Сервер бота".
  "name": "second-brain-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    // `npx wrangler kv namespace create DB` prints the id to paste here
    { "binding": "DB", "id": "8a7a7c6ecbe6485887d5471c26eb8e0c" }
  ],
  // habit reminders (only habits the user turned a reminder on for)
  "d1_databases": [
    { "binding": "SQL", "database_name": "second-brain", "database_id": "62e3c758-9040-4fc9-90ce-5ac8f32841cd", "migrations_dir": "migrations" }
  ],
  // every 5 minutes: send the reminders that are due
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "WEBAPP_URL": "https://miraggg3.github.io/second-brain/",
    // your Telegram user id: enables /refund <user_id> <charge_id>
    "ADMIN_ID": "8958919800"
  }
  // secrets (not in this file): BOT_TOKEN, WEBHOOK_SECRET
  //   npx wrangler secret put BOT_TOKEN
  //   npx wrangler secret put WEBHOOK_SECRET
}
